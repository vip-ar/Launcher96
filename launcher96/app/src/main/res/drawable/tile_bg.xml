<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#66FFFFFF" android:endColor="#26FFFFFF" />
            <stroke android:width="3dp" android:color="#F2FFFFFF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#3DFFFFFF" android:endColor="#12FFFFFF" />
            <stroke android:width="1dp" android:color="#47FFFFFF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
